# Supabase project settings -> Database -> Connection string -> URI.
# Must use the asyncpg driver scheme (postgresql+asyncpg://, not postgresql://).
# NOTE: the "Direct connection" host (db.<ref>.supabase.co) resolves IPv6-only
# on most Supabase projects today — if your environment has no IPv6 route,
# use the "Session pooler" connection string instead (Connection String tab
# in the dashboard); it looks like postgres.<ref>@aws-0-<region>.pooler.supabase.com:5432
# and is IPv4-reachable. Any special characters in the password (@, !, etc.)
# must be percent-encoded (@ -> %40, ! -> %21) or the URL won't parse.
DATABASE_URL=postgresql+asyncpg://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase project settings -> API -> JWT Secret / JWKS.
# Most projects today sign JWTs with an asymmetric key (ES256/RS256) rather
# than a shared secret — check https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json;
# a non-empty "keys" array means asymmetric signing, so set SUPABASE_URL below
# and leave SUPABASE_JWT_SECRET blank. Only older legacy-HS256 projects (or
# local dev/tests) need SUPABASE_JWT_SECRET instead.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# Comma-separated list of origins allowed to call this API (the frontend's dev/prod URLs).
CORS_ORIGINS=http://localhost:3000

# Razorpay Dashboard -> Settings -> API Keys / Webhooks. SeatServe is the
# merchant of record (no per-business Connect account yet) — leave these
# blank for local dev; the payments API responds 503 "provider not configured"
# instead of faking a successful payment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# File upload settings
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
